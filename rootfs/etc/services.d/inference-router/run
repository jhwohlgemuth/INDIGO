#!/usr/bin/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

host="${LLAMA_ARG_HOST:-0.0.0.0}"
port="${LLAMA_ARG_PORT:-10732}"

eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
exec llama-swap \
	--config "${HOME}/.config/llama-swap/config.yaml" \
	--listen "${host}:${port}" \
	--watch-config
