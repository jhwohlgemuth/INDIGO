#!/usr/bin/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

if [[ ! "${INDIGO_ENABLE_OPENVIKING:-0}" =~ ^(1|true|yes|on)$ ]]; then
	echo "Indigo OpenViking is disabled"
	exec sleep infinity
fi

config_file="${OPENVIKING_CONFIG_FILE:-${HOME}/.openviking/ov.conf}"
host="${OPENVIKING_SERVER_HOST:-127.0.0.1}"
port="${OPENVIKING_SERVER_PORT:-1933}"
server="${OPENVIKING_SERVER_BIN:-/opt/openviking/bin/openviking-server}"
retry_interval="${OPENVIKING_RETRY_INTERVAL:-300}"

install -d -m 0755 "$(dirname "${config_file}")"

if [[ ! -s "${config_file}" && -n "${OPENVIKING_CONF_CONTENT:-}" ]]; then
	printf '%s\n' "${OPENVIKING_CONF_CONTENT}" >"${config_file}"
	chmod 0600 "${config_file}"
fi

# s6 restarts a longrun that exits, so this service blocks instead of exiting
# while it waits. It reports the missing configuration once and then polls
# silently; exiting here would repeat that line every few seconds forever.
if [[ ! -s "${config_file}" ]]; then
	echo "OpenViking is waiting for ${config_file}; run 'openviking-server init' in the container"
	while [[ ! -s "${config_file}" ]]; do
		sleep 10
	done
	echo "OpenViking configuration found at ${config_file}"
fi

# openviking-server takes an opt-in --bot flag. Passing --with-bot or
# --without-bot makes argparse exit non-zero, and s6 then restarts the service
# in a loop that repeats the usage error every few seconds.
args=(--config "${config_file}" --host "${host}" --port "${port}")
if [[ "${OPENVIKING_WITH_BOT:-0}" == "1" ]]; then
	args+=(--bot)
fi

config_stamp() {
	stat -c '%Y:%s' "${config_file}" 2>/dev/null || printf 'none'
}

# A server that exits on a rejected configuration would otherwise be restarted
# by s6 several times a second, repeating the same error indefinitely. Retry on
# a bounded interval instead, and report the failure once per attempt. The wait
# ends early when the configuration file changes so a fix takes effect
# immediately.
while true; do
	status=0
	"${server}" "${args[@]}" || status=$?
	if [[ ${status} -eq 0 ]]; then
		exit 0
	fi

	echo "openviking-server exited with status ${status}; retrying in ${retry_interval}s" >&2
	stamp="$(config_stamp)"
	waited=0
	while ((waited < retry_interval)); do
		sleep 10
		waited=$((waited + 10))
		current_stamp="$(config_stamp)"
		if [[ "${current_stamp}" != "${stamp}" ]]; then
			echo "OpenViking configuration changed at ${config_file}"
			break
		fi
	done
done
