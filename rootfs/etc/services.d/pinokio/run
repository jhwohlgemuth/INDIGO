#!/usr/bin/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

export PINOKIO_HOME="${PINOKIO_HOME:-${HOME}/.pinokio}"
export PINOKIO_DOMAIN="${PINOKIO_DOMAIN:-pinokio.localhost}"
export PINOKIO_HTTPS_ACTIVE="${PINOKIO_HTTPS_ACTIVE:-1}"
export PINOKIO_NETWORK_ACTIVE="${PINOKIO_NETWORK_ACTIVE:-1}"
export PINOKIO_SYSTEM_CADDY=1
export HF_HOME="${HF_HOME:-${MODEL_DIRECTORY:-${HOME}/.models}/huggingface}"
export TORCH_HOME="${TORCH_HOME:-${MODEL_DIRECTORY:-${HOME}/.models}/torch}"
export PATH="/opt/pinokio/bin:/opt/pinokio/node/bin:${PATH}"

install -d -m 0755 "${PINOKIO_HOME}" "${HF_HOME}" "${TORCH_HOME}"
cd /opt/pinokio/app
exec npm start
