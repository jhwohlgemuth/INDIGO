#!/usr/bin/with-contenv bash
# shellcheck shell=bash
set -euo pipefail

model="${INDIGO_DEFAULT_MODEL:-gpt-oss-20b}"
model_path="${INDIGO_DEFAULT_MODEL_PATH:-${MODEL_DIRECTORY:-${HOME}/.models}/${model}}"
defaults_dir="${INDIGO_DEFAULTS_DIR:-/etc/indigo/defaults}"
router_mode="${INDIGO_ROUTER_MODE:-llama}"

if [[ "${router_mode}" == llama ]]; then
	if [[ ! "${model}" =~ ^[A-Za-z0-9._-]+$ ]]; then
		echo "INDIGO_DEFAULT_MODEL must contain only letters, numbers, dots, underscores, or hyphens" >&2
		exit 1
	fi
	if [[ ! "${model_path}" =~ ^/[A-Za-z0-9._/-]+$ ]]; then
		echo "INDIGO_DEFAULT_MODEL_PATH must be an absolute path containing only letters, numbers, dots, underscores, hyphens, or slashes" >&2
		exit 1
	fi
elif [[ "${router_mode}" != mlx ]]; then
	echo "INDIGO_ROUTER_MODE must be llama or mlx" >&2
	exit 1
fi

publish_default() {
	local temporary="$1"
	local target="$2"

	if ! ln "${temporary}" "${target}"; then
		if [[ ! -e "${target}" && ! -L "${target}" ]]; then
			rm -f -- "${temporary}"
			return 1
		fi
	fi
	rm -f -- "${temporary}"
}

render_default() {
	local source="$1"
	local target="$2"
	local mode="$3"
	local temporary

	if [[ -e "${target}" || -L "${target}" ]]; then
		return
	fi

	install -d -m 0755 "$(dirname "${target}")"
	temporary="$(mktemp "${target}.tmp.XXXXXX")"
	if ! sed \
		-e "s|__INDIGO_DEFAULT_MODEL__|${model}|g" \
		-e "s|__INDIGO_DEFAULT_MODEL_PATH__|${model_path}|g" \
		"${source}" >"${temporary}"; then
		rm -f -- "${temporary}"
		return 1
	fi
	if ! chmod "${mode}" "${temporary}"; then
		rm -f -- "${temporary}"
		return 1
	fi
	publish_default "${temporary}" "${target}"
}

install_default() {
	local source="$1"
	local target="$2"
	local mode="$3"
	local temporary

	if [[ -e "${target}" || -L "${target}" ]]; then
		return
	fi

	install -d -m 0755 "$(dirname "${target}")"
	temporary="$(mktemp "${target}.tmp.XXXXXX")"
	if ! install -m "${mode}" "${source}" "${temporary}"; then
		rm -f -- "${temporary}"
		return 1
	fi
	publish_default "${temporary}" "${target}"
}

if [[ "${router_mode}" == mlx ]]; then
	install_default "${defaults_dir}/llama-swap-mlx.yaml" \
		"${INDIGO_LLAMA_SWAP_CONFIG_FILE:-${HOME}/.config/llama-swap/config.yaml}" 0644
	opencode_source="${defaults_dir}/opencode-mlx.json"
else
	render_default "${defaults_dir}/llama-swap.yaml" \
		"${INDIGO_LLAMA_SWAP_CONFIG_FILE:-${HOME}/.config/llama-swap/config.yaml}" 0644
	opencode_source="${defaults_dir}/opencode.json"
fi

if [[ "${INDIGO_SEED_AGENT_CONFIG:-true}" == "true" ]]; then
	if [[ "${router_mode}" == mlx ]]; then
		install_default "${opencode_source}" "${HOME}/.config/opencode/opencode.json" 0644
	else
		render_default "${opencode_source}" "${HOME}/.config/opencode/opencode.json" 0644
	fi
	install_default "${defaults_dir}/codex.toml" "${HOME}/.codex/config.toml" 0600
fi
