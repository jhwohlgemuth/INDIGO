# Indigo environment.
#
# This file is the single source of truth for the image reference, host
# publishing, and instance identity. compose.yaml, the Makefile, and
# scripts/new.sh read these values and define no fallbacks for them.
# scripts/check.sh validates the file; run it with `make check`.
#
# Per-instance copies are generated, not hand-edited:
#
#   scripts/new.sh two
#   docker compose --env-file .env.two -p indigo-two up --detach

# Image
VERSION=0.1.4
REGISTRY=ghcr.io
REGISTRY_PROJECT=jhwohlgemuth
IMAGE=indigo
NOTEBOOK_VERSION=1.0.5

# Instance identity
INDIGO_HOSTNAME=indigo
PINOKIO_DOMAIN=pinokio.localhost
INDIGO_SHM_SIZE=2gb
INDIGO_STOP_GRACE_PERIOD=1m

# Host publishing
INDIGO_PUBLISH_HOST=127.0.0.1
INFERENCE_PUBLISHED_PORT=10732
INDIGO_MLX_PORT=10733
CODE_SERVER_PUBLISHED_PORT=1337
VERDACCIO_PUBLISHED_PORT=4873
JUPYTER_PUBLISHED_PORT=13337
MARIMO_PUBLISHED_PORT=13338
OPENVIKING_PUBLISHED_PORT=1933
PINOKIO_PUBLISHED_PORT=42000
PINOKIO_PROXY_PUBLISHED_PORT=42080
MCP_FILESYSTEM_PUBLISHED_PORT=11002
MCP_RUST_ANALYZER_PUBLISHED_PORT=11003

# Optional overrides; omit to use the defaults baked into compose.yaml and the
# image.
#
# INDIGO_WORKSPACE_PATH=./.indigo/workspace
# INDIGO_MODELS_PATH=./.indigo/models
# INDIGO_LLAMA_SWAP_CONFIG_PATH=./.indigo/llama-swap
# INDIGO_MLX_SWAP_CONFIG_PATH=./.indigo/mlx/llama-swap
# INDIGO_DEFAULT_MODEL=gpt-oss-20b
# INDIGO_DEFAULT_MODEL_PATH=/home/nonroot/.models/gpt-oss-20b
# RUST_ANALYZER_WORKSPACE=/home/nonroot/dev
# INDIGO_SEED_AGENT_CONFIG=true
# LLAMA_ARG_CTX_SIZE=0
# LLAMA_ARG_N_PARALLEL=2
# OPENVIKING_WITH_BOT=0
# OPENVIKING_CONF_CONTENT=
